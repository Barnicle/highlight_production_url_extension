{
  "name": "highlight-production-url-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Vite + TypeScript boilerplate for a Manifest V3 browser extension",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview --port 5174",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "keywords": [
    "chrome-extension",
    "manifest v3",
    "vite",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.2.1",
    "@eslint/js": "^9.39.0",
    "@types/chrome": "^0.0.190",
    "@types/node": "^20.19.24",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.8",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2 ",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react": "^7.37.5",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^5.1.0"
  },
  "dependencies": {
    "antd": "^5.28.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
