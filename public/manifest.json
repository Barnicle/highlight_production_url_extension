{
  "manifest_version": 3,
  "name": "Highlight Production URL",
  "version": "0.1.0",
  "description": "Example extension built with Vite + TypeScript (Manifest V3)",
  "action": {
    "default_popup": "src/popup.html"
  },
  "background": {
    "service_worker": "src/background.ts"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.ts"]
    }
  ]
}
